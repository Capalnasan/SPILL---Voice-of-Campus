{
  "name": "spill",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@spill/web",
    "build": "npm run build --workspace=@spill/web",
    "typecheck": "npm run typecheck --workspace=@spill/web",
    "lint": "npm run lint --workspace=@spill/web",
    "test": "npm run test --workspace=@spill/web",
    "test:e2e": "npm run test:e2e --workspace=@spill/web"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
